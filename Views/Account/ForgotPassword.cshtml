@{
    ViewData["Title"] = "Quên mật khẩu";
}

<h2>Quên mật khẩu</h2>
<p>Nhập email để nhận mã OTP đặt lại mật khẩu.</p>

<form method="post">
    <label>Email:</label>
    <input name="email" type="email" class="form-control" required />

    <button class="btn btn-primary mt-3">Gửi OTP</button>
</form>
