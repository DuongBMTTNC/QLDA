@model ApplicationUser

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    body {
        opacity: 0;
        transition: opacity 0.6s ease-in-out;
    }

        body.loaded {
            opacity: 1;
        }

    .fade-slide {
        opacity: 0;
        transform: translateY(25px);
        transition: all 0.7s ease;
    }

        .fade-slide.show {
            opacity: 1;
            transform: translateY(0);
        }
</style>

<h2 class="mb-4 fade-slide">Thông tin cá nhân</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success fade-slide">@TempData["Success"]</div>
}

<div class="row">

    <!-- Cột trái -->
    <div class="col-md-8 fade-slide">
        <div class="card p-4 shadow-sm" style="max-width: 500px;">
            <div class="text-center">
                <img src="@((Model.AvatarUrl ?? "/images/default-avatar.png") + "?t=" + DateTime.Now.Ticks)"
                     style="width:130px;height:130px;border-radius:50%;object-fit:cover;border:3px solid #0d6efd;" />

                <h4 class="mt-3">@Model.FullName</h4>
                <p class="text-muted">@Model.Email</p>
            </div>

            <div class="text-center mt-3">
                <button class="btn btn-primary" id="btnShowForm">
                    <i class="bi bi-pencil-square"></i> Cập nhật thông tin
                </button>

                <a asp-controller="Account" asp-action="ChangePassword"
                   class="btn btn-warning ms-2">
                    <i class="bi bi-shield-lock"></i> Đổi mật khẩu
                </a>
            </div>

            <form asp-action="UpdateProfile" method="post" enctype="multipart/form-data"
                  id="updateForm" class="mt-4" style="display:none;">
                <div class="mb-3">
                    <label>Họ tên</label>
                    <input type="text" name="fullName" class="form-control"
                           value="@Model.FullName" required />
                </div>

                <div class="mb-3">
                    <label>Avatar hiện tại</label><br />
                    <img src="@((Model.AvatarUrl ?? "/images/default-avatar.png") + "?t=" + DateTime.Now.Ticks)"
                         style="width:120px;height:120px;border-radius:50%;object-fit:cover;" />
                </div>

                <div class="mb-3">
                    <label>Chọn avatar mới</label>
                    <input type="file" name="avatar" class="form-control" />
                </div>

                <button class="btn btn-success">
                    <i class="bi bi-save"></i> Lưu thay đổi
                </button>

                <button type="button" class="btn btn-secondary ms-2" id="btnHideForm">
                    <i class="bi bi-x-circle"></i> Hủy
                </button>
            </form>
        </div>
    </div>

    <!-- Cột phải -->
    <div class="col-md-4 fade-slide">
        <div class="card shadow-sm p-3">
            <h5 class="fw-bold mb-3">📌 Tùy chọn nhanh</h5>

            <a asp-controller="Projects" asp-action="Index"
               class="btn btn-outline-primary w-100 mb-2">
                <i class="bi bi-folder2-open"></i> Danh sách dự án
            </a>

            <a asp-controller="TaskItems" asp-action="MyTasks"
               class="btn btn-outline-secondary w-100 mb-2">
                <i class="bi bi-list-task"></i> Công việc của tôi
            </a>

            <a asp-controller="Account" asp-action="ChangePassword"
               class="btn btn-outline-warning w-100 mb-2">
                <i class="bi bi-shield-lock"></i> Đổi mật khẩu
            </a>

            @{
                int count = ViewBag.NotificationCount ?? 0;
                string displayCount = count > 99 ? "99+" : count.ToString();
            }

            <a asp-controller="SystemNotifications" asp-action="MyNotifications"
               class="btn btn-outline-danger w-100 position-relative">
                <i class="bi bi-bell"></i> Thông báo của tôi

                @if (count > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle
                     badge rounded-pill bg-danger px-2 py-1"
                          style="font-size: 0.7rem;">
                        @displayCount
                    </span>
                }
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.onload = function () {
            document.body.classList.add("loaded");

            document.querySelectorAll('.fade-slide').forEach((el, index) => {
                setTimeout(() => {
                    el.classList.add('show');
                }, index * 150);
            });
        };

        document.getElementById("btnShowForm").onclick = function () {
            document.getElementById("updateForm").style.display = "block";
            this.style.display = "none";
        };

        document.getElementById("btnHideForm").onclick = function () {
            document.getElementById("updateForm").style.display = "none";
            document.getElementById("btnShowForm").style.display = "inline-block";
        };
    </script>
}
