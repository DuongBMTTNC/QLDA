@{
    ViewData["Title"] = "Xác nhận OTP";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow p-4" style="width: 420px; border-radius: 16px;">

        <h4 class="text-center mb-2">Xác nhận đổi mật khẩu</h4>

        <p class="text-center text-muted">
            Mã OTP đã gửi đến <b>@ViewBag.Email</b>
        </p>

        <form method="post">
            <input type="hidden" name="email" value="@ViewBag.Email" />

            <input name="otp" maxlength="6" class="form-control text-center fs-4" required />

            <button type="submit" class="btn btn-success w-100 mt-3">
                ✔ Xác nhận
            </button>
        </form>
    </div>
</div>
