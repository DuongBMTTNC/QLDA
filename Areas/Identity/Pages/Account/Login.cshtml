@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<style>
    body {
        background: linear-gradient(135deg, #e0f2ff, #c0d8ff);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: "Segoe UI", sans-serif;
    }

    /* Card login với animation khi load */
    .card-login {
        border-radius: 1rem;
        box-shadow: 0 0.5rem 2rem rgba(0,0,0,0.2);
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.6s ease-out;
    }

        .card-login.show {
            opacity: 1;
            transform: translateY(0);
        }

    /* Hover hiệu ứng cho nút */
    .btn-hover-zoom:hover {
        transform: scale(1.05);
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.3);
        transition: all 0.3s;
    }

    .external-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }
</style>

<div class="col-md-5 col-lg-4">
    <div id="loginCard" class="card card-login shadow-lg border-0">
        <div class="card-body p-5">
            <h2 class="card-title text-center mb-4 fw-bold text-primary">Welcome to Project Manager</h2>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" />
                    <label asp-for="Input.Email"><i class="bi bi-envelope-fill me-1"></i>Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" type="password" class="form-control" placeholder="Password" />
                    <label asp-for="Input.Password"><i class="bi bi-lock-fill me-1"></i>Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-3 btn-hover-zoom" style="background: linear-gradient(90deg,#4A90E2,#007BFF); font-weight:bold;">
                    Log in
                </button>

                <div class="text-center">
                    <p>
                        <a asp-controller="Account" asp-action="ForgotPassword" class="text-decoration-none">
                            Quên mật khẩu?
                        </a>
                    </p>
                    <p>
                        <a asp-controller="Account" asp-action="Register" class="text-decoration-none">
                            Đăng ký?
                        </a>
                    </p>
                </div>
            </form>

            <hr class="my-4">

            <!-- External Login -->
            <section>
                <h6 class="text-center text-muted mb-3">Or log in using</h6>

                @if ((Model.ExternalLogins?.Count ?? 0) == 0)
                {
                    <div class="text-center">
                        <p class="small text-muted">
                            No external authentication services configured. See
                            <a href="https://go.microsoft.com/fwlink/?LinkID=532715" target="_blank" class="text-decoration-none">this guide</a>.
                        </p>
                    </div>
                }
                else
                {
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-grid gap-2">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            var btnClass = provider.Name switch
                            {
                                "Google" => "btn btn-danger btn-hover-zoom external-btn",
                                "Facebook" => "btn btn-primary btn-hover-zoom external-btn",
                                "GitHub" => "btn btn-dark btn-hover-zoom external-btn",
                                _ => "btn btn-outline-secondary btn-hover-zoom external-btn"
                            };

                            <button type="submit" class="@btnClass btn-block" name="provider" value="@provider.Name">
                                <i class="bi bi-box-arrow-in-right"></i> @provider.DisplayName
                            </button>
                        }
                    </form>
                }
            </section>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Khi load page, thêm class show để trigger transition
        document.addEventListener("DOMContentLoaded", function() {
            const card = document.getElementById("loginCard");
            setTimeout(() => card.classList.add("show"), 100); // delay nhỏ để đẹp
        });
    </script>
}
